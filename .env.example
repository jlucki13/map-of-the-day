# --- Anthropic (enables LIVE mode: real sourcing + agent pipeline) ---------
# Absent => mock mode: static dataset only, deterministic stub agents.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown).
# ORCHESTRATOR_MODEL=claude-fable-5
# SUBAGENT_MODEL=claude-haiku-4-5

# --- Redis (via Vercel Marketplace) -----------------------------------------
# Absent => in-memory fallback (fine locally; loudly wrong on Vercel).
# Vercel's integration has provisioned this under different name pairs at
# different times — the app accepts either. Usually you only need to set the
# KV_REST_API_* pair below (auto-injected when you connect the integration);
# leave the UPSTASH_ pair blank unless you're wiring up Upstash directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Vercel Blob -----------------------------------------------------------
# Absent => disk fallback under public/dev-blob/ (fine locally only).
BLOB_READ_WRITE_TOKEN=

# --- Cron ------------------------------------------------------------------
# Required in production; Vercel sends it as "Authorization: Bearer <secret>"
# to /api/cron/generate-puzzle when set.
CRON_SECRET=

# --- Tuning (all optional; defaults shown) ---------------------------------
# Rotation interval. Shorten (e.g. 300) to test rotation locally.
# PUZZLE_INTERVAL_SECONDS=86400
# GENERATION_LOCK_TTL_SECONDS=180
# DEDUPE_WINDOW_SIZE=20
# MAX_CANDIDATES_PER_GENERATION=12
# MAX_OCR_BLOCKS_FOR_REDACTOR=12

# Wikimedia asks for an honest User-Agent with contact info.
# WIKIMEDIA_USER_AGENT="MapOfTheDayBot/0.1 (https://your-site.example; you@example.com)"
